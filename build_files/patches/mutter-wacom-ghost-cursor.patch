diff -ru a/mutter-50.1/clutter/clutter/clutter-stage.c b/mutter-50.1/clutter/clutter/clutter-stage.c
--- a/mutter-50.1/clutter/clutter/clutter-stage.c	2026-04-14 15:37:46.000000000 +0200
+++ b/mutter-50.1/clutter/clutter/clutter-stage.c	2026-08-07 01:15:26.417324849 +0200
@@ -3566,6 +3566,14 @@
   if (clutter_sprite_get_role (sprite) == CLUTTER_SPRITE_ROLE_TOUCHPOINT)
     return TRUE;
 
+  /* Patch D: skip tablet sprites marked out-of-proximity (set by Patch C,
+   * cleared by Patch A).  Without this guard, every relayout after
+   * PROXIMITY_OUT calls pick_and_update_sprite() for the lingering sprite,
+   * re-creating the cursor renderer and leaving a ghost cursor. */
+  if (clutter_sprite_get_role (sprite) == CLUTTER_SPRITE_ROLE_TABLET &&
+      g_object_get_data (G_OBJECT (sprite), "wacom-out-of-proximity"))
+    return TRUE;
+
   clutter_sprite_get_coords (sprite, &coords);
   pointer_view = clutter_stage_get_view_at (stage,
                                             coords.x,
diff -ru a/mutter-50.1/src/backends/native/meta-seat-native.c b/mutter-50.1/src/backends/native/meta-seat-native.c
--- a/mutter-50.1/src/backends/native/meta-seat-native.c	2026-04-14 15:37:46.000000000 +0200
+++ b/mutter-50.1/src/backends/native/meta-seat-native.c	2026-08-07 01:15:26.416178044 +0200
@@ -105,7 +105,16 @@
 
       sprite = clutter_backend_get_sprite (clutter_backend, stage, event);
       if (sprite)
-        meta_seat_native_remove_cursor_renderer (seat_native, sprite);
+        {
+          meta_seat_native_remove_cursor_renderer (seat_native, sprite);
+          /* Patch C: mark this sprite as out-of-proximity so that
+           * update_devices_in_view (Patch D) skips it on relayouts.
+           * Without this, pick_and_update_sprite() re-creates the cursor
+           * renderer and a ghost cursor appears at the pen's last position.
+           * The marker is cleared on PROXIMITY_IN by Patch A. */
+          g_object_set_data (G_OBJECT (sprite), "wacom-out-of-proximity",
+                             GINT_TO_POINTER (TRUE));
+        }
     }
 
   return FALSE;
