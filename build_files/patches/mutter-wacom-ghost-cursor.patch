+  if (clutter_event_type (event) == CLUTTER_PROXIMITY_IN)
+    g_object_set_data (G_OBJECT (sprite), "wacom-out-of-proximity", NULL);
+
   cursor_renderer =
     meta_backend_get_cursor_renderer_for_sprite (backend, sprite);
   if (cursor_renderer)
